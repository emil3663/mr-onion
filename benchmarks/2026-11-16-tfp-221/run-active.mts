// TFP-221 (Phase 43, Acceptance Criterion 7): one Standard run on the local with-bugs Toolshop copy, through the app,
// with active tests on. It drives the app's own API as the UI does (useCrawl, useGeneration, useRun): a crawl, the
// page selection by type, the inspection, the generation, then POST /api/run with `enableActive: true`. The generate
// request is the CLI's buildGenerateRequest, which src/cli/run.test.ts holds byte for byte to the UI's.
// Usage (from the repo root, with the app on :3100):
//   node --import ./scripts/register-node-test-ts-resolver.mjs --experimental-strip-types <this> <app> <site> <outDir>
import { mkdir, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { pathToFileURL } from "node:url";

const root = process.cwd();
const load = (path: string) => import(pathToFileURL(join(root, path)).href);
const { buildConfig } = await load("src/cli/config.ts");
const { buildGenerateRequest } = await load("src/cli/run.ts");
const { normalizeInspectionPaths, typeSelectedPaths } = await load("src/app/_lib/derive.ts");
const { STANDARD_RUN } = await load("src/lib/comprehensive/run-mode.ts");

const [app, site, outDir] = process.argv.slice(2);
await mkdir(outDir, { recursive: true });
const log = (line: string) => console.log(`${new Date().toISOString().slice(11, 19)} ${line}`);
const save = (name: string, value: unknown) => writeFile(join(outDir, name), typeof value === "string" ? value : JSON.stringify(value, null, 2), "utf8");

async function call(method: string, path: string, body?: unknown) {
    const response = await fetch(`${app}${path}`, { method, headers: { "content-type": "application/json" }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
    const data = await response.json();
    if (!response.ok) throw new Error(`${method} ${path}: ${response.status} ${JSON.stringify(data).slice(0, 500)}`);
    return data;
}
const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

log(`crawl ${site}`);
let crawl = await call("POST", "/api/crawl", { baseUrl: site });
while (crawl.crawlStatus === "running") {
    await wait(2000);
    crawl = await call("GET", `/api/crawl?crawlId=${encodeURIComponent(crawl.crawlId)}`);
}
if (crawl.crawlStatus !== "completed") throw new Error(`crawl ${crawl.crawlStatus}: ${crawl.error ?? ""}`);
await save("crawl.json", crawl.result);
const paths: string[] = normalizeInspectionPaths(site, [], typeSelectedPaths(crawl.result, STANDARD_RUN));
log(`crawled ${crawl.result.pageCount} page(s); testing ${paths.length}: ${paths.join(", ")}`);

const profile = await call("POST", "/api/introspect", { baseUrl: site, paths, namedFlows: [] });
await save("page-data.json", profile);
log(`inspected ${profile.pages?.length ?? 0} page(s)`);

const config = buildConfig({}, { url: site }, root);
const generateBody = buildGenerateRequest(config, paths, profile) as Record<string, unknown>;
const generated = await call("POST", "/api/generate", generateBody);
await save("suite.spec.ts", generated.code);
await save("generate-meta.json", Object.fromEntries(Object.entries(generated).filter(([key]) => key !== "code")));
log(`generated by ${generated.generatedBy ?? "?"}${generated.fallbackReason ? ` (${generated.fallbackReason})` : ""}`);

const runBody = {
    code: generated.code,
    selectedPractices: generateBody.selectedPractices,
    auditMode: generateBody.auditMode,
    baseUrl: site,
    description: generateBody.description,
    excludeTestTitles: [],
    includeTestTitles: [],
    contentProfile: profile,
    enableInteractive: false,
    enableActive: true,
};
let run = await call("POST", "/api/run", runBody);
log(`run ${run.runId} ${run.runStatus}`);
while (run.runStatus === "queued" || run.runStatus === "running") {
    await wait(5000);
    run = await call("GET", `/api/run?runId=${encodeURIComponent(run.runId)}`);
    log(`run ${run.runStatus}: ${run.progress?.completedTests ?? 0} of ${run.progress?.totalTests ?? "?"}`);
}
await save("report.json", run.result);
await save("run-output.txt", run.result?.output ?? "");
log(`done: ${run.runStatus}, ${JSON.stringify(run.result?.report?.summary ?? {})}`);
